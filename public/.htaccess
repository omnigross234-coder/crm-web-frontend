Options -MultiViews
RewriteEngine On
RewriteBase /ogclient/ogc/

# UX-WEB-014: serve the app's own branded 404 page (generated by
# app/not-found.tsx at build time) instead of Apache's/hosting default for
# any URL under this app that doesn't resolve to a real file or a rewrite
# rule below.
ErrorDocument 404 /ogclient/ogc/404.html

# Let Apache serve real exported files and folders first.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Next static export only has a placeholder for dynamic lead routes.
# Reuse it for real lead IDs created after build time, including RSC payloads.
RewriteRule ^leads/([^/]+)/edit/?$ leads/placeholder/edit/index.html [L]
RewriteRule ^leads/([^/]+)/edit/index\.txt$ leads/placeholder/edit/index.txt [L]
RewriteRule ^leads/([^/]+)/edit\.txt$ leads/placeholder/edit/index.txt [L]
RewriteRule ^leads/([^/]+)/edit/(__next\..*)$ leads/placeholder/edit/$2 [L]

RewriteRule ^leads/([^/]+)/?$ leads/placeholder/index.html [L]
RewriteRule ^leads/([^/]+)/index\.txt$ leads/placeholder/index.txt [L]
RewriteRule ^leads/([^/]+)\.txt$ leads/placeholder/index.txt [L]
RewriteRule ^leads/([^/]+)/(__next\..*)$ leads/placeholder/$2 [L]


# Phase 5 (Tenant Management Control Center): same placeholder pattern, for
# the tenant detail route.
RewriteRule ^admin/clients/([^/]+)/?$ admin/clients/placeholder/index.html [L]
RewriteRule ^admin/clients/([^/]+)/index\.txt$ admin/clients/placeholder/index.txt [L]
RewriteRule ^admin/clients/([^/]+)\.txt$ admin/clients/placeholder/index.txt [L]
RewriteRule ^admin/clients/([^/]+)/(__next\..*)$ admin/clients/placeholder/$2 [L]

# Phase 6 (Super Admin User Management): same placeholder pattern, for the
# platform user detail route.
RewriteRule ^admin/platform/users/([^/]+)/?$ admin/platform/users/placeholder/index.html [L]
RewriteRule ^admin/platform/users/([^/]+)/index\.txt$ admin/platform/users/placeholder/index.txt [L]
RewriteRule ^admin/platform/users/([^/]+)\.txt$ admin/platform/users/placeholder/index.txt [L]
RewriteRule ^admin/platform/users/([^/]+)/(__next\..*)$ admin/platform/users/placeholder/$2 [L]
